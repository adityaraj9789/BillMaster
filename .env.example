# GEMINI_API_KEY: Required for Gemini Vision bill scanning and product matching.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Optional - app operates offline-first with auto-sync when configured)
# Frontend public environment variables:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only secrets (never expose to client-side bundles):
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

